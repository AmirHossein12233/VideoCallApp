# =========================
# VideoCallApp - Git Ignore
# =========================

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment / secrets
.env
.env.*
!.env.example

# SQLite database
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Capacitor / Android build files
android/.gradle/
android/build/
android/app/build/
android/.idea/
android/.kotlin/
android/local.properties

# Android generated files
*.apk
*.aab
*.apks
*.dex

# Signing keys - NEVER upload
*.jks
*.keystore
*.p12
*.pfx

# Gradle
.gradle/
build/

# IDE - VS Code
.vscode/
*.code-workspace

# IDE - IntelliJ / Android Studio
.idea/
*.iml

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo

# Python distribution
dist/
build/
*.egg-info/

# Coverage
.coverage.*
.pytest_cache/

# Frontend temporary files
frontend/.cache/
frontend/.temp/

# Capacitor generated
android/capacitor-cordova-android-plugins/
android/capacitor.settings.gradle